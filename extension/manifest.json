{
  "manifest_version": 3,
  "name": "Shortmox Radar — Public Beta",
  "version": "1.0.0",
  "description": "Shortmox Radar extension for live multi-source intelligence alerts and anomaly signals.",
  "permissions": ["storage", "notifications", "activeTab"],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1:8080/*", "http://localhost:8080/*"],
      "js": ["dashboard_bridge.js"],
      "run_at": "document_start"
    }
  ]
}
