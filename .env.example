# Copy this file to .env and fill every required blank value with a unique secret.
# Never commit .env. Restrict it with chmod 600 on Unix-like systems.
POSTGRES_USER=radar_app
POSTGRES_DB=shortmox_radar
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
CLICKHOUSE_PASSWORD=
RADAR_SESSION_SECRET=
RADAR_INGEST_API_KEY=
# Generate the PBKDF2 hash using the command in DEPLOY.md.
RADAR_USERS_JSON=

# Local loopback HTTP settings. Use secure cookies and your HTTPS origin for a public deployment.
RADAR_COOKIE_SECURE=false
RADAR_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Public token: embedded in the browser bundle if present.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Collection and all external exports are opt-in.
COLLECTION_ENABLED=false
COLLECTION_MAX_RESULTS=25
COLLECTION_MAX_X_PAGES=5
COLLECTION_MAX_TELEGRAM_MESSAGES=100
X_COLLECTION_PROVIDER=scraping
X_SCRAPING_CREDENTIAL_SOURCE=env
X_PROXY_SOURCE=env
# Keep all X credentials on the server. The GraphQL token is required for enabled scraping.
X_AUTH_TOKEN=
X_CT0=
X_PROXY_URL=
X_GRAPHQL_BEARER_TOKEN=
# Only for X_COLLECTION_PROVIDER=api.
X_BEARER_TOKEN=
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_COLLECTION_BOT_TOKEN=
TELEGRAM_SESSION_STRING=
TELEGRAM_TARGET_CHANNELS=
PUBLIC_CHAIN_LOOKUPS_ENABLED=false
SIEM_EXPORT_ENABLED=false
SIEM_WEBHOOK_URL=
# Optional reachable model server; the default loopback endpoint has no service in the container.
OLLAMA_URL=
